@using System.Xml.Linq;
@inject HttpClient Http

@page "/importar"

<PageTitle>Importar NF-e</PageTitle>

<h1> Importar NF-e</h1>

<p>Selecione o arquivo XML para validação.</p>

<InputFile OnChange="SelecionarArquivo"></InputFile>

@if (!string.IsNullOrEmpty(nomeArquivo))
{
    <p>Arquivo selecionado: @nomeArquivo</p>
}

@if (!string.IsNullOrEmpty(xml))
{
    <h3>Conteúdo do XML</h3>

    <pre>@xml</pre>

    <button @onclick="ValidarXml"
            disabled="@validando">

        @if (validando)
        {
            <span>Validando...</span>
        }
        else
        {
            <span>Validar XML</span>
        }

    </button>
}


@code
{
    private bool validando = false;
    private bool? validacaoSucesso = null;
    private string mensagem = "";

    private string? nomeArquivo;
    private string? xml;

    private async Task SelecionarArquivo(InputFileChangeEventArgs e)
    {
        var arquivo = e.File;

        nomeArquivo = arquivo.Name;

        using var stream = arquivo.OpenReadStream();

        using var reader = new StreamReader(stream);

        var conteudo = await reader.ReadToEndAsync();

        var documento = XDocument.Parse(conteudo);

        xml = documento.ToString();

        Console.WriteLine(xml);
    }

   
    private async Task ValidarXml()
    {
        try
        {
            validando = true;
            validacaoSucesso = null;
            mensagem = "";

            Console.WriteLine("=== INÍCIO DA VALIDAÇÃO ===");

            if (string.IsNullOrWhiteSpace(xml))
            {
                Console.WriteLine("XML está vazio.");

                validacaoSucesso = false;
                mensagem = "Nenhum XML foi carregado.";

                return;
            }

            Console.WriteLine($"Arquivo: {nomeArquivo}");
            Console.WriteLine($"Tamanho XML: {xml.Length} caracteres");

            var conteudo = new ByteArrayContent(
                System.Text.Encoding.UTF8.GetBytes(xml));

            using var form = new MultipartFormDataContent();

            form.Add(
                conteudo,
                "arquivo",
                nomeArquivo);

            Console.WriteLine("Enviando requisição para:");
            Console.WriteLine($"{Http.BaseAddress}api/nfe/Importar");

            var resposta = await Http.PostAsync(
                "api/nfe/Importar",
                form);

            Console.WriteLine($"Status Code: {(int)resposta.StatusCode}");
            Console.WriteLine($"Status: {resposta.StatusCode}");

            var corpoResposta = await resposta.Content.ReadAsStringAsync();

            Console.WriteLine("Resposta da API:");
            Console.WriteLine(corpoResposta);

            if (!resposta.IsSuccessStatusCode)
            {
                Console.WriteLine("A API respondeu com erro.");

                validacaoSucesso = false;
                mensagem = "O XML não pôde ser validado.";

                return;
            }

            Console.WriteLine("Validação realizada com sucesso.");

            validacaoSucesso = true;
            mensagem = "XML validado com sucesso!";
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine("=== ERRO HTTP ===");
            Console.WriteLine($"Mensagem: {ex.Message}");
            Console.WriteLine($"InnerException: {ex.InnerException?.Message}");
            Console.WriteLine($"StackTrace: {ex.StackTrace}");

            validacaoSucesso = false;
            mensagem = "Não foi possível conectar à API.";
        }
        catch (Exception ex)
        {
            Console.WriteLine("=== ERRO GERAL ===");
            Console.WriteLine($"Tipo: {ex.GetType().FullName}");
            Console.WriteLine($"Mensagem: {ex.Message}");
            Console.WriteLine($"StackTrace: {ex.StackTrace}");

            validacaoSucesso = false;
            mensagem = "Ocorreu um erro durante a validação.";
        }
        finally
        {
            validando = false;
        }
    }
}